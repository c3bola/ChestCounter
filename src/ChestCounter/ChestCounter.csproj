<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>ContadorDeBau</AssemblyName>
    <RootNamespace>ChestCounter</RootNamespace>
    <Version>3.3.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChestCounter.Infrastructure.Tests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\ChestCounter.Core\ChestCounter.Core.csproj" />
    <ProjectReference Include="..\ChestCounter.Application\ChestCounter.Application.csproj" />
    <ProjectReference Include="..\ChestCounter.Infrastructure\ChestCounter.Infrastructure.csproj" />
    <Compile Include="Program.cs" />
    <Compile Include="App.axaml.cs" />
    <Compile Include="Platform\Windows\*.cs" />
    <Compile Include="Services\*.cs" />
    <Compile Include="ViewModels\*.cs" />
    <Compile Include="Views\**\*.cs" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Assets\burbarkfont.ttf" LogicalName="ChestCounter.Assets.burbarkfont.ttf" />
  </ItemGroup>
</Project>
