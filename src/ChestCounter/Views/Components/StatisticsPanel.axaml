<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChestCounter"
             x:Class="ChestCounter.StatisticsPanel">
  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <local:MetricCard DataContext="{Binding Metrics[0]}" />
      <local:MetricCard Grid.Column="1" DataContext="{Binding Metrics[1]}" />
      <local:MetricCard Grid.Row="1" DataContext="{Binding Metrics[2]}" />
      <local:MetricCard Grid.Row="1" Grid.Column="1" DataContext="{Binding Metrics[3]}" />
      <local:MetricCard Grid.Row="2" DataContext="{Binding Metrics[4]}" />
      <local:MetricCard Grid.Row="2" Grid.Column="1" DataContext="{Binding Metrics[5]}" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
      <Button Classes="dashboard-action" Command="{Binding ToggleOverlayCommand}" ToolTip.Tip="{Binding OverlayStatus}"
              HorizontalAlignment="Stretch" MinHeight="56"
              BorderBrush="{StaticResource BrandGradient}" BorderThickness="2">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Ellipse Fill="{Binding OverlayIndicator}" Width="13" Height="13" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding OverlayButtonText}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Grid.Column="1" Classes="dashboard-action" Command="{Binding OpenReportCommand}" HorizontalAlignment="Stretch" MinHeight="56">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
          <Path Data="M3 20 V13 H8 V20 Z M10 20 V8 H15 V20 Z M17 20 V3 H22 V20 Z"
                Fill="{StaticResource Cyan}" Width="23" Height="23" Stretch="Uniform" />
          <TextBlock Grid.Column="1" Text="{Binding ReportButtonText}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Grid.Column="2" Classes="dashboard-action" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" MinHeight="56">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
          <Path Data="M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M5 5 L7 7 M17 17 L19 19 M19 5 L17 7 M7 17 L5 19"
                Stroke="{StaticResource PrimaryText}" StrokeThickness="2.4" Width="23" Height="23" Stretch="Uniform" />
          <TextBlock Grid.Column="1" Text="{Binding SettingsButtonText}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>
    <Button Grid.Row="2" IsVisible="{Binding ShowUpdate}" Command="{Binding InstallUpdateCommand}"
            Content="{Binding InstallText}" Background="{StaticResource Cyan}" Foreground="#071218" />
  </Grid>
</UserControl>
