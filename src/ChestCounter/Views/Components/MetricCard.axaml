<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChestCounter.MetricCard">
  <Border Classes="dashboard-card" MinHeight="96" Padding="19,9">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
        <Path Data="{Binding Icon}" Stroke="{Binding IconAccent}" StrokeThickness="1.8"
              Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding Caption}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="34"
                 FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
