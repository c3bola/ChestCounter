<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             x:Class="ChestCounter.TeamPanel">
  <UserControl.Styles>
    <Style Selector="Border.team-value">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.team-value.player">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandGradient}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.team-number.player">
      <Setter Property="Foreground" Value="{StaticResource Green}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="dashboard-card" ClipToBounds="True" MinHeight="148">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,1.25*" ColumnSpacing="8" Margin="20,5,0,4">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
          <Path Data="M12 2 A3 3 0 1 1 12 8 A3 3 0 1 1 12 2 M5 5 A2.5 2.5 0 1 1 5 10 A2.5 2.5 0 1 1 5 5 M19 5 A2.5 2.5 0 1 1 19 10 A2.5 2.5 0 1 1 19 5 M6 20 C6 15 8 11 12 11 C16 11 18 15 18 20 Z M0 20 C0 16 1 12 5 12 C6 12 7 12 8 13 C6 15 5 18 5 20 Z M19 20 C19 18 18 15 16 13 C17 12 18 12 19 12 C23 12 24 16 24 20 Z"
                Fill="{StaticResource Green}" Width="34" Height="28" Stretch="Uniform" />
          <TextBlock Grid.Column="1" Text="{Binding TeamSubtitle}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Column="1" Background="{StaticResource BrandGradient}" CornerRadius="16,16,0,0" Padding="16,6"
                IsVisible="{Binding HasTeamSummary}" HorizontalAlignment="Right">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Path Data="M12 2 A3 3 0 1 1 12 8 A3 3 0 1 1 12 2 M5 5 A2.5 2.5 0 1 1 5 10 A2.5 2.5 0 1 1 5 5 M19 5 A2.5 2.5 0 1 1 19 10 A2.5 2.5 0 1 1 19 5 M6 20 C6 15 8 11 12 11 C16 11 18 15 18 20 Z M0 20 C0 16 1 12 5 12 C6 12 7 12 8 13 C6 15 5 18 5 20 Z M19 20 C19 18 18 15 16 13 C17 12 18 12 19 12 C23 12 24 16 24 20 Z"
                  Fill="{StaticResource PrimaryText}" Width="28" Height="23" Stretch="Uniform" />
            <TextBlock Grid.Column="1" Text="{Binding TeamSummary}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,1,1,0"
              CornerRadius="16,16,0,0" Background="{StaticResource PanelBackground}" Padding="18,9">
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding TeamMembers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><primitives:UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0" Padding="5,0" Margin="0,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" Margin="4,0,0,2" />
                    <Border Classes="team-value" Classes.player="{Binding IsPlayer}" CornerRadius="12" Padding="5,0">
                      <TextBlock Classes="team-number" Classes.player="{Binding IsPlayer}" Text="{Binding Value}"
                                 FontSize="29" FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding TeamMessage}" Foreground="{StaticResource SecondaryText}"
                     IsVisible="{Binding HasTeamMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
